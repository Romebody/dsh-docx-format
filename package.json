{
  "name": "dsh-docx-format",
  "version": "1.0.0",
  "type": "module",
  "description": "所有生成的 .docx 自动套用《通用公文格式规范》——工具 + 提示词规则 + 结果钩子。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "docx",
    "word",
    "ooxml",
    "document-format",
    "chinese-official-document"
  ],
  "author": "Romebody",
  "homepage": "https://github.com/Romebody/dsh-docx-format#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Romebody/dsh-docx-format.git"
  },
  "bugs": {
    "url": "https://github.com/Romebody/dsh-docx-format/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./docxfmt.py": "./lib/docxfmt.py",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/docxfmt.py",
    "lib/docx_read.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
